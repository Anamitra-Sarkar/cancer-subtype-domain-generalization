# Copy to .env and fill values. Never commit real secrets.
# Backend release gate (fail-closed — all default to NOT approved)
MODEL_RELEASE_APPROVED=false  # set to "true" only when an artifact revision is explicitly approved for serving
APPROVED_ARTIFACT_REVISION=   # example: v1  — must be non-empty when MODEL_RELEASE_APPROVED=true; checked by backend/model_store.py:30-31
MODEL_ARTIFACT_PATH=model_artifacts/model.pkl  # path to pickled model artifact (backend/model_store.py:32)

# Auth (backend/auth.py:39-40)
REQUIRE_AUTH=false  # set to "true" to enforce Firebase bearer-token verification
FIREBASE_SERVICE_ACCOUNT_PATH=  # example: /secrets/firebase-service-account.json — JSON service-account file for Firebase Admin SDK

# Backend runtime
PORT=8000  # uvicorn port (backend/Dockerfile + docker-compose.yml)

# Frontend (frontend/src/App.tsx:15 — read via import.meta.env.VITE_API_URL)
VITE_API_URL=  # example: http://localhost:8000  — leave empty for same-origin (relative URLs); set to backend URL in deployed envs
